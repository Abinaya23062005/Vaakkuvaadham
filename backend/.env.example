PORT=5000
NODE_ENV=development

# Get free key from console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here

# Optional - app works without MongoDB using in-memory storage
MONGODB_URI=mongodb://localhost:27017/nyayaai

FRONTEND_URL=http://localhost:3000

# Get from dashboard.razorpay.com -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET

# Firebase Admin (required for server-side usage-limit enforcement)
# Option A (local dev): download serviceAccountKey.json from
#   Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
#   and save it as backend/serviceAccountKey.json (already gitignored)
# Option B (hosting providers like Render/Railway): paste the full JSON
#   contents as a single-line string into this variable instead
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...",...}

LOG_LEVEL=info
